{
  "name": "rn-native-search-bar-example-tvos",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "ios": "EXPO_TV=1 expo run:ios",
    "prebuild": "EXPO_TV=1 expo prebuild --clean --platform ios"
  },
  "dependencies": {
    "expo": "~57.0.27",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.3-0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.18",
    "typescript": "~6.0.3",
    "@react-native-tvos/config-tv": "~0.1.7"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    },
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
