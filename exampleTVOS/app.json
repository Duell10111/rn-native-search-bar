{
  "expo": {
    "name": "rn-native-search-bar-example-tvos",
    "slug": "rn-native-search-bar-example-tvos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "expo.modules.rnnativesearchbar.exampleTVOS"
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "showVerboseWarnings": false,
          "tvosDeploymentTarget": "16.4"
        }
      ]
    ]
  }
}
